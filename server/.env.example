# Server Listening Port (Default fallback: 5001)
PORT=5001

# MongoDB Connection String (Render Private MongoDB Service URL or local MongoDB)
MONGO_URI=mongodb://localhost:27017/gringotts

# JWT Secret Key for Session Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# Brevo Transactional Email API Key & Sender Identity
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Gringotts Wizarding Bank

# Allowed Client Origin URL for CORS (e.g. Vercel Production Frontend URL)
CLIENT_URL=http://localhost:5173
